{
  "name": "llm4orovo",
  "version": "0.7.8",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "description": "A local optimization conversation workspace",
  "author": "FYPPPPP",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node server/launcher.mjs --browser",
    "desktop": "electron .",
    "test": "node --test test/*.test.mjs",
    "test:ci": "node --test test/math.test.mjs test/model-export.test.mjs test/preflight.test.mjs test/providers.test.mjs test/launcher.test.mjs",
    "licenses": "node scripts/licenses.mjs",
    "package": "npm run build && npm run licenses && npm run stage && electron-builder --win dir",
    "package:installer": "npm run build && npm run licenses && npm run stage && electron-builder --win nsis",
    "solver:prepare": "node scripts/prepare-solver.mjs",
    "stage": "node scripts/stage-app.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.132.1",
    "@google/genai": "2.28.0",
    "katex": "0.16.47",
    "lucide-react": "1.54.0",
    "openai": "7.31.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "overrides": {
    "node-int64": "0.4.0",
    "@malept/flatpak-bundler": "0.4.0"
  },
  "build": {
    "appId": "org.fyppppp.slime",
    "productName": "llm4orOvO",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release/0.7.8",
      "app": "build/stage"
    },
    "files": [
      "**/*",
      "!**/node_modules{,/**/*}",
      "!docs{,/**/*}"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/saturn.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "extraFiles": [
      {
        "from": "scripts/Browser.cmd",
        "to": "Browser.cmd"
      },
      {
        "from": "README.txt",
        "to": "README.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      }
    ],
    "asarUnpack": [
      "server/secrets.ps1"
    ],
    "extraResources": [
      {
        "from": "runtime/python",
        "to": "runtime/python",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/tests/**",
          "!**/test/**",
          "!**/examples/**",
          "!**/benchmarks/**"
        ]
      },
      {
        "from": "solver",
        "to": "solver",
        "filter": [
          "*.py"
        ]
      }
    ],
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "compression": "maximum",
    "npmRebuild": false
  }
}
