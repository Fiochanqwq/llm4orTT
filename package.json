{
  "name": "llm4ortt",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Contextual inverse optimization from operational logs and historical decisions",
  "author": "FYPPPPP",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/clean-dist.mjs && tsc --noEmit && vite build",
    "start": "node server/launcher.mjs --browser",
    "desktop": "electron .",
    "test": "node --test --test-timeout=60000 test/inverse.test.mjs test/inverse-economy.test.mjs test/workspace.test.mjs test/providers.test.mjs test/launcher.test.mjs test/loopback.test.mjs test/chat.test.mjs",
    "test:ci": "npm test",
    "test:inverse": "node scripts/inverse.mjs test && node --test test/inverse.test.mjs",
    "benchmark:inverse": "node scripts/inverse.mjs --out outputs/inverse/synthetic-benchmark.json --seeds 17",
    "qa:browser": "node scripts/inverse-qa.mjs",
    "qa:desktop": "node scripts/inverse-desktop-qa.mjs",
    "licenses": "node scripts/licenses.mjs",
    "stage": "node scripts/stage-app.mjs",
    "package": "npm run build && npm run licenses && npm run stage && electron-builder --win dir",
    "solver:prepare": "node scripts/setup-solver.mjs",
    "qa:chat": "node scripts/chat-qa.mjs",
    "experiment:replay": "node scripts/research-local.mjs",
    "test:research": "node scripts/research-local.mjs --test",
    "experiment:mamo": "node scripts/mamo-local.mjs",
    "test:mamo": "node scripts/mamo-test.mjs",
    "qa:mamo": "node scripts/mamo-report-qa.mjs",
    "audit:mamo": "node scripts/mamo-audit.mjs",
    "qa:mamo-audit": "node scripts/mamo-audit-qa.mjs",
    "experiment:multifamily": "node scripts/multifamily-local.mjs",
    "test:multifamily": "node scripts/multifamily-local.mjs --test",
    "qa:multifamily": "node scripts/multifamily-qa.mjs",
    "experiment:stress": "node scripts/stress-public.mjs",
    "test:stress": "node scripts/stress-public.mjs --test",
    "qa:stress": "node scripts/stress-qa.mjs",
    "test:certification": "node scripts/certification-test.mjs",
    "test:certification-ui": "node tools/test_desktop_certification.cjs && node tools/test_desktop_sensitivity.cjs",
    "experiment:publication": "node scripts/publication-study.mjs",
    "audit:publication": "node scripts/publication-study.mjs --audit-only"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.132.1",
    "@google/genai": "2.28.0",
    "lucide-react": "1.54.0",
    "openai": "7.31.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "rehype-katex": "7.0.1",
    "katex": "0.16.47"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "overrides": {
    "node-int64": "0.4.0",
    "@malept/flatpak-bundler": "0.4.0"
  },
  "build": {
    "appId": "org.fyppppp.llm4ortt",
    "productName": "llm4orTT",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release/0.1.2",
      "app": "build/stage"
    },
    "files": [
      "**/*",
      "!**/node_modules{,/**/*}",
      "!docs{,/**/*}"
    ],
    "win": {
      "target": "dir",
      "icon": "assets/saturn.ico",
      "signAndEditExecutable": true
    },
    "extraFiles": [
      {
        "from": "scripts/Browser.cmd",
        "to": "Browser.cmd"
      },
      {
        "from": "README.txt",
        "to": "README.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      }
    ],
    "asarUnpack": [
      "server/secrets.ps1"
    ],
    "extraResources": [
      {
        "from": "runtime/python",
        "to": "runtime/python",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/tests/**",
          "!**/test/**",
          "!**/examples/**",
          "!**/benchmarks/**"
        ]
      },
      {
        "from": "solver",
        "to": "solver",
        "filter": [
          "inverse.py",
          "inverse_local.py",
          "inverse_benchmark.py",
          "inverse_certified.py",
          "inverse_sensitivity.py"
        ]
      }
    ],
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "compression": "maximum",
    "npmRebuild": false
  },
  "homepage": "https://github.com/Fiochanqwq/llm4orTT#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fiochanqwq/llm4orTT.git"
  },
  "bugs": {
    "url": "https://github.com/Fiochanqwq/llm4orTT/issues"
  },
  "engines": {
    "node": ">=24"
  }
}
